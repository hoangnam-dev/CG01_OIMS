@OrderSystem.Api_HostAddress = http://localhost:5284

GET {{OrderSystem.Api_HostAddress}}/api/foundation/success
Accept: application/json
X-Correlation-ID: 11111111-1111-1111-1111-111111111111

###

GET {{OrderSystem.Api_HostAddress}}/health/live

###

GET {{OrderSystem.Api_HostAddress}}/health/ready

###

GET {{OrderSystem.Api_HostAddress}}/api/orders?page=1&pageSize=20&status=PendingPayment&sortDirection=desc
Accept: application/json
Authorization: Bearer {{accessToken}}

###

GET {{OrderSystem.Api_HostAddress}}/api/orders/{{orderId}}
Accept: application/json
Authorization: Bearer {{accessToken}}

###

@idempotencyKey = 11111111-1111-1111-1111-111111111111
@productVariantId = replace-with-an-active-variant-id-that-has-stock

# Original request: expect 201 Created without Idempotency-Replayed.
POST {{OrderSystem.Api_HostAddress}}/api/orders
Accept: application/json
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "items": [
    {
      "productVariantId": "{{productVariantId}}",
      "quantity": 1
    }
  ]
}

###

# Exact replay: expect the same 201 status/body/Location and Idempotency-Replayed: true.
POST {{OrderSystem.Api_HostAddress}}/api/orders
Accept: application/json
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "items": [
    {
      "productVariantId": "{{productVariantId}}",
      "quantity": 1
    }
  ]
}

###

# Reused key with a different semantic request: expect 409 IDEMPOTENCY_KEY_REUSED.
POST {{OrderSystem.Api_HostAddress}}/api/orders
Accept: application/problem+json
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "items": [
    {
      "productVariantId": "{{productVariantId}}",
      "quantity": 2
    }
  ]
}
