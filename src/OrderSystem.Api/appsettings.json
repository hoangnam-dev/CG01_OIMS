{
  "Database": {
    "ConnectionString": "Host=localhost;Port=5433;Database=oims;Username=oims"
  },
  "Jwt": {
    "Issuer": "OrderSystem.Api",
    "Audience": "OrderSystem.Client",
    "AccessTokenLifetime": "00:15:00"
  },
  "Authentication": {
    "RefreshPermitLimit": 10,
    "RefreshWindow": "00:01:00",
    "RefreshTokenCleanupInterval": "01:00:00",
    "RefreshTokenCleanupBatchSize": 500,
    "ExpiredRefreshTokenRetention": "1.00:00:00"
  },
  "AdminBootstrap": {
    "Enabled": false
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "ProductTtl": "00:05:00"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "oims"
  },
  "Reservation": {
    "Duration": "00:15:00",
    "ExpirationScanInterval": "00:01:00",
    "BatchSize": 100
  },
  "Retry": {
    "MaxAttempts": 3,
    "Delay": "00:00:01"
  },
  "Payment": {
    "ReconciliationInterval": "00:01:00",
    "ReconciliationBatchSize": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "FilePath": "logs/oims-api-.log"
  },
  "AllowedHosts": "*"
}
