{
  "Database": {
    "ConnectionString": "Host=localhost;Port=5433;Database=oims;Username=oims"
  },
  "Payment": {
    "ReconciliationInterval": "00:01:00",
    "ReconciliationBatchSize": 100
  },
  "Reservation": {
    "Duration": "00:15:00",
    "ExpirationScanInterval": "00:01:00",
    "BatchSize": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "FilePath": "logs/oims-worker-.log"
  }
}