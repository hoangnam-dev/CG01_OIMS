# Local development only. Replace all credentials outside an isolated workstation.
OIMS_INFRA_BIND_ADDRESS=127.0.0.1
OIMS_APP_BIND_ADDRESS=127.0.0.1
OIMS_API_PORT=8080
OIMS_IMAGE_TAG=local
OIMS_POSTGRES_DB=oims
OIMS_POSTGRES_USER=oims
OIMS_POSTGRES_PASSWORD=replace_with_a_local_only_password
OIMS_POSTGRES_PORT=5433
OIMS_REDIS_PASSWORD=replace_with_a_local_only_password
OIMS_REDIS_PORT=6379
OIMS_RABBITMQ_USER=oims
OIMS_RABBITMQ_PASSWORD=replace_with_a_local_only_password
OIMS_RABBITMQ_PORT=5672
OIMS_RABBITMQ_MANAGEMENT_PORT=15672
OIMS_RABBITMQ_MAIN_QUEUE_MAX_LENGTH_BYTES=1048576
OIMS_RABBITMQ_RETRY_QUEUE_MAX_LENGTH_BYTES=1048576
OIMS_RABBITMQ_DEAD_LETTER_QUEUE_MAX_LENGTH_BYTES=1048576
OIMS_RABBITMQ_MAX_MESSAGE_SIZE_BYTES=1048576

# Generate a unique Base64 value from at least 32 random bytes before starting
# the API container. Keep the actual value in the local untracked .env file.
OIMS_JWT_SIGNING_KEY=

# To connect from another trusted machine, set OIMS_INFRA_BIND_ADDRESS=0.0.0.0
# and restrict these ports to trusted source IPs with the host/network firewall.
# Do not expose PostgreSQL, Redis, or RabbitMQ directly to the public Internet.

# Compose reads the local untracked .env file or process environment. For host
# `dotnet run`, set Jwt__SigningKey separately as described in README.md. Optional
# Admin bootstrap uses AdminBootstrap__Enabled, AdminBootstrap__Email, and
# AdminBootstrap__Password. Never commit resolved secret values.
